{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii/current.txt",
        "padding": {
            "top": 2,
            "right": 10,
            "left": 4
        },
        "width": 20,
        "height": 8,
        "color": {
            "1": "213",
            "2": "117",
            "3": "226"
        }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "246",
            "title": "32"
        }
    },
    "modules": [
        "break",
        "title",
        "break",
        "os",
        "kernel",
        {
            "type": "packages",
            "format": "{} (pacman)"
        },
        "shell",
        "terminal",
        {
            "type": "wm",
            "format": "{}"
        },
        {
            "type": "cpu",
            "temp": true
        },
        {
            "type": "gpu",
            "temp": true
        },
        "memory",
        {
            "type": "disk",
            "path": "/"
        },
        "uptime",
        "break",
        "colors",
        "break"
    ]
}